# ==============================================================================
# LUMORA FINE JEWELRY - ENVIRONMENT CONFIGURATION
# Domain: lumorafinejewelery.com
# Specialized for Indian Export to United States & Canada
# ==============================================================================

# Server Port
PORT=3001

# Admin Portal Security Passkey (Required to access store admin dashboard)
ADMIN_PASSWORD=LUMORA2026

# Stripe India Export Gateway Configuration
# 1. Sign up / log into your Stripe India account (https://dashboard.stripe.com)
# 2. Add your Indian Current Account, GSTIN, and IEC (Import Export Code)
# 3. Set Purpose Code to: P0103 (Export of goods)
# 4. Copy your Test or Live API keys below:
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Storefront URL
VITE_SITE_URL=https://lumorafinejewelery.com

# DHL / FedEx International Shipping Account (Optional direct API integration)
DHL_ACCOUNT_NUMBER=
DHL_API_KEY=
